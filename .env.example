# --- LLM provider: azure_openai | bedrock | openai | anthropic ---
LLM_PROVIDER=azure_openai
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AWS_REGION=us-east-1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# --- Langfuse tracing ---
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- SEC EDGAR: required User-Agent "Name email", max 10 requests/second ---
SEC_USER_AGENT="Your Name your.email@example.com"
TICKERS=JPM,BAC,C,WFC,GS,MS,USB,PNC,TFC,COF
FILING_YEARS=3

# --- Kafka (weeks 5 to 6) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NEW=filings.new
KAFKA_TOPIC_INDEXED=filings.indexed
KAFKA_TOPIC_DLQ=filings.dlq

# --- Agent limits (week 4) ---
AGENT_MAX_STEPS=8
AGENT_TOKEN_BUDGET=20000
